# Optional systemd user service.
#
#   systemctl --user enable --now dji-rc-joystick
#
# Set the controller address first, e.g.:
#   systemctl --user set-environment DJI_RC_IP=192.168.1.42
# or edit ExecStart below.
[Unit]
Description=DJI RC virtual joystick
After=network-online.target

[Service]
Type=simple
Environment=DJI_RC_IP=
ExecStart=%h/.local/lib/dji-rc-linux/dji-rc-joystick ${DJI_RC_IP}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
